          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vianmääritykseen: säilyttää viimeisen %lld minuutin seurannan ja lisää seurantakaavioon vientipainikkeen CSV-tallennusta varten"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vianmääritykseen: säilyttää viimeiset %lld minuuttia seurannasta ja lisää seurantakaavioon vientipainikkeen CSV-tallennusta varten"
