    "Deselected %lld of %lld that never rise above %lld° from here in the next 7 days: %@.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fravalgte %1$lld af %2$lld, der aldrig når over %3$lld° herfra de næste 7 dage: %4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld abgewählt, die in den nächsten 7 Tagen von hier aus nie über %3$lld° steigen: %4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Deselected %1$lld of %2$lld that never rise above %3$lld° from here in the next 7 days: %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseleccionados %1$lld de %2$lld que nunca salen por encima de %3$lld° desde aquí en los próximos 7 días: %4$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistettiin valinta %1$lld/%2$lld satelliitilta, jotka eivät nouse täältä yli %3$lld° seuraavien 7 päivän aikana: %4$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernet %1$lld av %2$lld som aldri stiger over %3$lld° herfra de neste 7 dagene: %4$@."
