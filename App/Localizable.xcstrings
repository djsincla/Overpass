    "Any address that serves two- or three-line element sets, for example a CelesTrak GP query with FORMAT=tle.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver adresse, der leverer to- eller trelinjers elementsæt, for eksempel en CelesTrak GP-forespørgsel med FORMAT=tle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Adresse, die Zwei- oder Dreizeilen-Elementsätze liefert, zum Beispiel eine CelesTrak-GP-Abfrage mit FORMAT=tle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dirección que sirva conjuntos de elementos de dos o tres líneas, por ejemplo una consulta GP de CelesTrak con FORMAT=tle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tahansa osoite, joka tarjoaa kaksi- tai kolmirivisiä elementtijoukkoja, esimerkiksi CelesTrak GP -haku parametrilla FORMAT=tle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver adresse som leverer elementsett på to eller tre linjer, for eksempel en CelesTrak GP-spørring med FORMAT=tle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk adres dat twee- of drieregelige elementensets levert, bijvoorbeeld een CelesTrak GP-query met FORMAT=tle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfri adress som levererar element i två- eller treradsformat, till exempel en CelesTrak GP-fråga med FORMAT=tle."
          }
        }
      }
    },
