    "No camera found. For an iPhone: keep it near the Mac, unlocked, signed in to the same Apple ID.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet kamera fundet. For en iPhone: hold den nær Mac'en, ulåst og logget ind med samme Apple-id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kamera gefunden. Für ein iPhone: in der Nähe des Mac, entsperrt und mit derselben Apple-ID angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cámara. Para un iPhone: mantenerlo cerca del Mac, desbloqueado y con la sesión iniciada en el mismo Apple ID."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraa ei löytynyt. iPhone: pidä se Macin lähellä, avattuna ja kirjautuneena samalla Apple ID:llä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke noe kamera. For en iPhone: hold den nær Macen, ulåst og logget på samme Apple-ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen camera gevonden. Voor een iPhone: houd hem bij de Mac, ontgrendeld en ingelogd met dezelfde Apple ID."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kamera hittades. För en iPhone: håll den nära datorn, olåst och inloggad på samma Apple-ID."
          }
        }
      }
    },
