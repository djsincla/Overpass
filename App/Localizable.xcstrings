    },
    "A different way round from the reading.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drejet en anden vej rundt end aflæsningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Drehlage als der Messwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sentido distinto al de la lectura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eri kierrosasento kuin lukema."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen vei rundt enn avlesningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere draaistand dan de uitlezing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat varv än avläsningen."
          }
        }
      }
    },
    "A minute before tracking starts": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et minut før sporingen starter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Minute vor Beginn der Nachführung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minuto antes de iniciar el seguimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuutti ennen seurannan alkua"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett minutt før følgingen starter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een minuut voordat het volgen begint"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En minut innan följningen börjar"
          }
        }
      }
    },
    "A pass counts as visible when the satellite is sunlit and the Sun is below this altitude for you (−6° civil, −12° nautical twilight).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En passage regnes som synlig, når satellitten er solbelyst, og Solen står under denne højde hos dig (−6° borgerligt, −12° nautisk tusmørke)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Überflug gilt als sichtbar, wenn der Satellit von der Sonne beleuchtet ist und die Sonne am Standort unter dieser Höhe steht (−6° bürgerliche, −12° nautische Dämmerung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso cuenta como visible cuando el satélite está iluminado por el Sol y el Sol está por debajo de esta altitud para usted (−6° crepúsculo civil, −12° náutico)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylilento lasketaan näkyväksi, kun satelliitti on auringon valaisema ja Aurinko on sinulla tämän korkeuden alapuolella (−6° porvarillinen, −12° merenkulullinen hämärä)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En passering regnes som synlig når satellitten er solbelyst og solen står lavere enn denne høyden hos deg (−6° borgerlig, −12° nautisk skumring)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een passage telt als zichtbaar als de satelliet door de zon wordt verlicht en de zon voor jou onder deze hoogte staat (−6° burgerlijke, −12° nautische schemering)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En passage räknas som synlig när satelliten är solbelyst och solen står under denna höjd hos dig (−6° borgerlig, −12° nautisk skymning)."
          }
        }
      }
    },
    "A source that's on appears in the sidebar with its satellites. Turning one off keeps it here, so you can turn it back on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kilde, der er slået til, vises i sidepanelet med sine satellitter. Slår du en fra, bliver den her, så du kan slå den til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine aktive Quelle erscheint mit ihren Satelliten in der Seitenleiste. Eine deaktivierte bleibt hier und kann wieder aktiviert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fuente activada aparece en la barra lateral con sus satélites. Al desactivarla se mantiene aquí para poder volver a activarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päällä oleva lähde näkyy sivupalkissa satelliitteineen. Pois päältä kytketty lähde jää tänne, joten voit kytkeä sen takaisin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kilde som er på, vises i sidepanelet med satellittene sine. Slår du en av, blir den liggende her, så du kan slå den på igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bron die aan staat, verschijnt met zijn satellieten in de zijbalk. Een uitgeschakelde bron blijft hier staan, zodat je hem weer kunt inschakelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En källa som är på visas i sidofältet med sina satelliter. Om du stänger av en ligger den kvar här, så att du kan slå på den igen."
          }
        }
      }
    },
    "A tick each second, like WWV on 10 MHz, and a long 1000 Hz tone as tracking begins": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tik hvert sekund som WWV på 10 MHz og en lang 1000 Hz-tone, når sporingen begynder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ticken pro Sekunde wie bei WWV auf 10 MHz und ein langer 1000-Hz-Ton zu Beginn der Nachführung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tic cada segundo, como WWV en 10 MHz, y un tono largo de 1000 Hz al iniciar el seguimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikitys joka sekunti kuten WWV:llä 10 MHz:llä ja pitkä 1000 Hz:n ääni seurannan alkaessa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tikk hvert sekund, som WWV på 10 MHz, og en lang tone på 1000 Hz når følgingen starter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tik per seconde, zoals WWV op 10 MHz, en een lange toon van 1000 Hz als het volgen begint"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tick varje sekund, som WWV på 10 MHz, och en lång ton på 1000 Hz när följningen börjar"
          }
        }
      }
    },
