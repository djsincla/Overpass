    "Uses the cable stop, altitude limits and axis speeds from Settings. Passes near the zenith need a fast azimuth swing, so the mount may lose them briefly at the top.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger kabelstop, højdegrænser og aksehastigheder fra Indstillinger. Passager nær zenit kræver et hurtigt azimutsving, så monteringen kan miste dem kortvarigt øverst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Kabelanschlag, Höhengrenzen und Achsgeschwindigkeiten aus den Einstellungen. Überflüge nahe dem Zenit erfordern einen schnellen Azimutschwenk, daher kann die Montierung sie oben kurz verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el tope del cable, los límites de altitud y las velocidades de los ejes de Ajustes. Los pasos cerca del cenit necesitan un giro rápido en azimut, así que la montura puede perderlos brevemente en lo más alto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää kaapelirajoitinta, korkeusrajoja ja akselinopeuksia Asetuksista. Lähellä zeniittiä kulkevat ylilennot vaativat nopean atsimuuttikäännön, joten jalusta voi kadottaa ne hetkeksi ylhäällä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker kabelstoppet, høydegrensene og aksehastighetene fra Innstillinger. Passeringer nær senit krever en rask asimutsving, så monteringen kan miste dem kort på toppen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de kabelaanslag, hoogtegrenzen en assnelheden uit Instellingen. Passages bij het zenit vereisen een snelle azimutzwenk, dus de montering kan ze bovenaan even kwijtraken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder kabelstopp, höjdgränser och axelhastigheter från Inställningar. Passager nära zenit kräver en snabb azimutsvängning, så monteringen kan tappa dem en kort stund vid toppen."
          }
        }
      }
    },
