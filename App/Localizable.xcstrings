            "state": "translated",
            "value": "En 1500 Hz-tone, WWV-tidssignalets timemarkering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein 1500-Hz-Ton, die Stundenmarke des WWV-Zeitsignals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tono de 1500 Hz, la marca horaria de la señal de WWV"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1500 Hz:n ääni, WWV-aikamerkin tuntimerkki"
          }
        },
        "nb": {
