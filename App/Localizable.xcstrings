    "Every star with an IAU name to magnitude 4, brightest first. Passive tracking sends the mount there and lets it track at the sidereal rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stern mit IAU-Namen bis Größenklasse 4, hellste zuerst. Die passive Nachführung fährt die Montierung dorthin und lässt sie siderisch nachführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las estrellas con nombre de la IAU hasta magnitud 4, las más brillantes primero. El seguimiento Pasivo envía la montura allí y la deja seguir a velocidad sideral."
          }
        }
      }
    },
