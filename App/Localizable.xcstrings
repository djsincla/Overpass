    "Moves the azimuth axis about 25°, including across north, to learn how the mount's own slew counts position. Stand by the mount.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drejer azimutaksen omkring 25°, også hen over nord, for at lære, hvordan monteringens egen svingning tæller position. Bliv ved monteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht die Azimutachse um etwa 25°, auch über Norden, um zu lernen, wie der eigene Schwenk der Montierung die Position zählt. Bei der Montierung bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el eje de azimut unos 25°, incluido el cruce por el norte, para aprender cómo cuenta la posición la propia montura al girar. Permanecer junto a la montura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kääntää atsimuuttiakselia noin 25°, myös pohjoisen yli, oppiakseen, miten jalustan oma kääntö laskee sijainnin. Pysy jalustan luona."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreier asimutaksen omtrent 25°, også over nord, for å lære hvordan monteringens egen sving teller posisjon. Stå ved monteringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait de azimutas ongeveer 25°, ook over het noorden, om te leren hoe de eigen zwenk van de montering de positie telt. Blijf bij de montering."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrider azimutaxeln ungefär 25°, även över norr, för att lära sig hur monteringens egen svängning räknar position. Stå vid monteringen."
          }
        }
      }
    },
