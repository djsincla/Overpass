    "Search matches names, numbers, owners and launch dates, and compares attributes: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgningen matcher navne, numre, ejere og opsendelsesdatoer og sammenligner egenskaber: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche findet Namen, Nummern, Eigentümer und Startdaten und vergleicht Attribute: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda coincide con nombres, números, propietarios y fechas de lanzamiento, y compara atributos: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haku löytää nimet, numerot, omistajat ja laukaisupäivät ja vertaa ominaisuuksia: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søket treffer navn, numre, eiere og oppskytingsdatoer, og sammenligner egenskaper: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoekfunctie vindt namen, nummers, eigenaars en lanceerdatums en vergelijkt kenmerken: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen matchar namn, nummer, ägare och uppskjutningsdatum och jämför egenskaper: launched>2020, period<100, perigee>500, inc>50, rcs>10, span>20, size=large, owner=PRC, type=debris."
          }
        }
      }
    },
