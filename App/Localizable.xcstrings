    "Step": {
      "comment": "Tracking mode: a goto repeated every few seconds",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinvis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrittweise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por pasos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Askel"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinnvis"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapsgewijs"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg"
          }
        }
      }
    },
    "Step: repeats a goto to where the target will be. Fine for antennas; jumpy in a telescope.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinvis: gentager en goto til, hvor målet vil være. Fint til antenner; hakkende i et teleskop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrittweise: wiederholt ein GoTo dorthin, wo das Ziel sein wird. Gut für Antennen; ruckelig im Teleskop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por pasos: repite un goto hacia donde estará el objetivo. Bien para antenas; a saltos en un telescopio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Askel: toistaa goton kohtaan, jossa kohde tulee olemaan. Sopii antenneille; nykivä kaukoputkessa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinnvis: gjentar en goto dit målet vil være. Greit for antenner; hakkete i et teleskop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapsgewijs: herhaalt een goto naar waar het doel zal zijn. Prima voor antennes; schokkerig in een telescoop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg: upprepar en goto dit målet kommer att vara. Bra för antenner; ryckigt i ett teleskop."
          }
        }
      }
    },
    "Stepping every %@ s · az %@° alt %@°": {
      "localizations": {
        "da": {
