    "Held at the altitude limit (%lld°). Change it with Point down to.": {
      "comment": "“Point down to” is the name of a slider on the Camera screen",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt ved højdegrænsen (%lld°). Skift den med Peg ned til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Höhengrenze (%lld°) gehalten. Mit „Herab bis“ ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido en el límite de altitud (%lld°). Cambiarlo con Bajar hasta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty korkeusrajalle (%lld°). Muuta sitä asetuksella Alas enintään."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt ved høydegrensen (%lld°). Endre den med Pek ned til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgehouden op de hoogtegrens (%lld°). Wijzig dit met ‘Omlaag tot’."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hålls vid höjdgränsen (%lld°). Ändra den med Peka ner till."
          }
        }
      }
    },
