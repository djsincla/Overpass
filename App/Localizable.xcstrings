          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ins Bild klicken, wohin das Teleskop zeigt, falls nicht zur Mitte (Sucher oder Kamera neben dem Tubus)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click where the telescope points in the image, if it isn't the center (a finder, or a camera beside the tube)"
          }
        },
        "en-GB": {
          "stringUnit": {
