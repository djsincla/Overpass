            "value": "Askel %1$@ s välein · az %2$@° kork %3$@°"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg hvert %1$@ s · az %2$@° høy %3$@°"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
