          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en los próximos %lld días con estos ajustes. Probar con una culminación más baja o más días."
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ei mitään seuraavan %lld päivän aikana näillä asetuksilla. Kokeile matalampaa huippua tai useampaa päivää."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ei mitään seuraavien %lld päivän aikana näillä asetuksilla. Kokeile matalampaa huippua tai useampaa päivää."
                }
              }
            }
          }
        },
        "nb": {
