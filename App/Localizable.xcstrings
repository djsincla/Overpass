    "%@ crosses north, which the mount doesn't turn through. Going the long way round takes about %lld s, then tracking carries on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ krydser nord, som monteringen ikke drejer igennem. Den lange vej rundt tager omkring %2$lld s, derefter fortsætter sporingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ quert Norden, wo die Montierung nicht durchdreht. Der lange Weg dauert etwa %2$lld s, dann geht die Nachführung weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ crosses north, which the mount doesn't turn through. Going the long way round takes about %2$lld s, then tracking carries on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cruza el norte, por donde la montura no gira. Dar la vuelta larga lleva unos %2$lld s; después continúa el seguimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ylittää pohjoisen, jonka läpi jalusta ei käänny. Pitkä reitti kestää noin %2$lld s, sitten seuranta jatkuu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ krysser nord, som monteringen ikke dreier gjennom. Den lange veien rundt tar omtrent %2$lld s, så fortsetter følgingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passeert het noorden, waar de montering niet doorheen draait. De lange weg om duurt ongeveer %2$lld s, daarna gaat het volgen verder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passerar norr, som monteringen inte vrider sig genom. Långa vägen runt tar ungefär %2$lld s, sedan fortsätter följningen."
          }
        }
      }
    },
