    "Stopped %@° past north. Unwind before tracking again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet %@° forbi nord. Drej tilbage, før du sporer igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@° über Norden hinaus gestoppt. Vor erneuter Nachführung zurückdrehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido %@° pasado el norte. Desenrollar antes de volver a seguir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty %@° pohjoisen ohi. Kierrä takaisin ennen uutta seurantaa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet %@° forbi nord. Rull tilbake før du følger igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt %@° voorbij het noorden. Draai terug voordat je weer volgt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad %@° förbi norr. Vrid tillbaka innan du följer igen."
          }
        }
      }
    },
