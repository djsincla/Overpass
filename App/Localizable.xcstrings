          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: den bevægelse ville svinge gennem kabelstoppet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt: Diese Bewegung würde durch den Kabelanschlag schwenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: ese movimiento pasaría por el tope del cable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty: liike kääntyisi kaapelirajoittimen läpi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: den bevegelsen ville svingt gjennom kabelstoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt: die beweging zou door de kabelaanslag zwenken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad: den förflyttningen skulle svänga genom kabelstoppet."
          }
        }
      }
    },
    "Stopped: the mount didn't reach the start point within 5 minutes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen nåede ikke startpunktet inden for 5 minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt: Die Montierung hat den Startpunkt nicht innerhalb von 5 Minuten erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: la montura no llegó al punto inicial en 5 minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty: jalusta ei saavuttanut aloituspistettä 5 minuutissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen nådde ikke startpunktet innen 5 minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt: de montering bereikte het startpunt niet binnen 5 minuten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad: monteringen nådde inte startpunkten inom 5 minuter."
          }
        }
      }
    },
    "Stopped: the mount gave no position.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen gav ingen position."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt: Die Montierung meldete keine Position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: la montura no dio ninguna posición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty: jalusta ei antanut sijaintia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen ga ingen posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt: de montering gaf geen positie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad: monteringen gav ingen position."
          }
        }
      }
    },
    "Stopped: the mount turned but the object stayed as far from the aim point. It may be fixed in the picture (the camera's text, a mark on the lens), or the calibration may be off.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen drejede, men objektet forblev lige langt fra sigtepunktet. Det kan sidde fast i billedet (kameraets tekst, et mærke på linsen), eller kalibreringen kan være forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt: Die Montierung hat sich gedreht, aber das Objekt blieb gleich weit vom Zielpunkt entfernt. Es ist evtl. fest im Bild (Text der Kamera, Fleck auf der Linse), oder die Kalibrierung stimmt nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: la montura giró pero el objeto siguió igual de lejos del punto de mira. Puede estar fijo en la imagen (el texto de la cámara, una marca en la lente) o la calibración puede ser incorrecta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty: jalusta kääntyi, mutta kohde pysyi yhtä kaukana tähtäyspisteestä. Se voi olla kiinteä osa kuvaa (kameran teksti, jälki linssissä), tai kalibrointi voi olla pielessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet: monteringen dreide seg, men objektet ble værende like langt fra siktepunktet. Det kan være fast i bildet (kameraets tekst, et merke på linsen), eller kalibreringen kan være feil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt: de montering draaide, maar het object bleef even ver van het richtpunt. Het zit misschien vast in het beeld (tekst van de camera, een vlek op de lens), of de kalibratie klopt niet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad: monteringen vred sig men objektet låg kvar lika långt från siktpunkten. Det kan sitta fast i bilden (kamerans text, ett märke på linsen), eller så kan kalibreringen vara fel."
          }
        }
      }
    },
