    "Look for cameras again (an iPhone appears when it's nearby, locked and on the same Apple ID)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg efter kameraer igen (en iPhone vises, når den er i nærheden, låst og på samme Apple-id)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut nach Kameras suchen (ein iPhone erscheint, wenn es in der Nähe, gesperrt und mit derselben Apple-ID angemeldet ist)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a buscar cámaras (un iPhone aparece cuando está cerca, bloqueado y con el mismo Apple ID)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsi kameroita uudelleen (iPhone näkyy, kun se on lähellä, lukittuna ja samalla Apple ID:llä)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk etter kameraer igjen (en iPhone vises når den er i nærheten, låst og på samme Apple-ID)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek opnieuw naar camera's (een iPhone verschijnt als hij in de buurt is, vergrendeld en met dezelfde Apple ID)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök efter kameror igen (en iPhone visas när den är i närheten, låst och på samma Apple-ID)"
          }
        }
      }
