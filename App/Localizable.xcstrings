    "Normal mode, but the mount still reported a placeholder position after 20 s, so it wasn't synced": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaltilstand, men monteringen rapporterede stadig en pladsholderposition efter 20 s, så den blev ikke synkroniseret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, aber die Montierung meldete nach 20 s noch eine Platzhalterposition, daher nicht synchronisiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal, pero la montura seguía indicando una posición provisional tras 20 s, así que no se sincronizó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaalitila, mutta jalusta ilmoitti yhä paikkamerkkisijainnin 20 s jälkeen, joten sitä ei synkronoitu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, men monteringen meldte fortsatt en plassholderposisjon etter 20 s, så den ble ikke synkronisert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale modus, maar de montering meldde na 20 s nog een tijdelijke positie, dus er is niet gesynchroniseerd"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalläge, men monteringen rapporterade fortfarande en platshållarposition efter 20 s, så den synkades inte"
          }
        }
      }
    },
    "Normal mode, synced on %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaltilstand, synkroniseret på %@"
          }
        },
        "de": {
