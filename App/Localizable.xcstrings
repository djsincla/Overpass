    "Changes the picture only, not what's tracked": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer kun billedet, ikke hvad der spores"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nur das Bild, nicht die Nachführung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia la imagen, no lo que se sigue"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaa vain kuvaa, ei seurattavaa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrer bare bildet, ikke det som følges"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verandert alleen het beeld, niet wat er gevolgd wordt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrar bara bilden, inte vad som följs"
          }
        }
      }
    },
