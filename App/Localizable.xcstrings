    "Digital zoom: crops the camera's full-resolution picture (pinch to zoom too on the Camera screen)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital zoom: beskærer kameraets billede i fuld opløsning (knib også for at zoome på kameraskærmen)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalzoom: schneidet das Kamerabild in voller Auflösung zu (im Kamerabildschirm auch mit zwei Fingern zoomen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom digital: recorta la imagen a resolución completa de la cámara (también se puede pellizcar para ampliar en la pantalla Cámara)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitaalinen zoom: rajaa kameran täysresoluutioista kuvaa (zoomaa myös nipistämällä Kamera-näytöllä)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital zoom: beskjærer kameraets bilde i full oppløsning (du kan også knipe for å zoome på Kamera-skjermen)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitale zoom: snijdt het camerabeeld op volle resolutie bij (op het camerascherm kun je ook knijpen om te zoomen)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital zoom: beskär kamerans bild i full upplösning (nyp för att zooma på kameraskärmen också)"
          }
        }
      }
    },
