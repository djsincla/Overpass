    "Fine: %lld′ %@. Shifts the tracking offsets while Step or Smooth tracking; otherwise a short slow move.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin: %1$lld′ %2$@. Forskyder sporingens offsets under trinvis eller glidende sporing; ellers en kort, langsom bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fein: %1$lld′ %2$@. Verschiebt bei schrittweiser oder gleitender Nachführung die Offsets; sonst eine kurze, langsame Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Fine: %1$lld′ %2$@. Shifts the tracking offsets while Step or Smooth tracking; otherwise a short slow move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino: %1$lld′ %2$@. Desplaza las compensaciones del seguimiento durante el seguimiento Por pasos o Suave; si no, un movimiento corto y lento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hieno: %1$lld′ %2$@. Siirtää seurannan poikkeamia askel- tai tasaisen seurannan aikana; muuten lyhyt hidas liike."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin: %1$lld′ %2$@. Forskyver følgingsforskyvningene under trinnvis eller jevn følging; ellers en kort, langsom bevegelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijn: %1$lld′ %2$@. Verschuift de volgoffsets tijdens stapsgewijs of vloeiend volgen; anders een korte, langzame beweging."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin: %1$lld′ %2$@. Flyttar följningens förskjutningar under steg- eller mjuk följning; annars en kort, långsam förflyttning."
          }
        }
      }
    },
    "Fix the iPhone to the tube (3× or 5× lens), start the camera, centre a bright star, and calibrate. Then start Smooth tracking and turn on Guide.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør iPhonen til tubussen (3×- eller 5×-objektiv), start kameraet, centrer en klar stjerne, og kalibrer. Start derefter glidende sporing, og slå Guiding til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone am Tubus befestigen (3×- oder 5×-Objektiv), Kamera starten, hellen Stern zentrieren und kalibrieren. Dann gleitende Nachführung starten und Guiding einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the iPhone to the tube (3× or 5× lens), start the camera, center a bright star, and calibrate. Then start Smooth tracking and turn on Guide."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the iPhone to the tube (3× or 5× lens), start the camera, centre a bright star, and calibrate. Then start Smooth tracking and turn on Guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar el iPhone al tubo (lente 3× o 5×), iniciar la cámara, centrar una estrella brillante y calibrar. Después iniciar el seguimiento Suave y activar Guiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä iPhone putkeen (3× tai 5× objektiivi), käynnistä kamera, keskitä kirkas tähti ja kalibroi. Aloita sitten tasainen seuranta ja kytke Ohjaus päälle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest iPhone til tuben (3×- eller 5×-objektiv), start kameraet, sentrer en klar stjerne og kalibrer. Start så jevn følging og slå på Guiding."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig de iPhone aan de tubus (3×- of 5×-lens), start de camera, centreer een heldere ster en kalibreer. Start dan vloeiend volgen en schakel Guiden in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst iPhone på tuben (3×- eller 5×-objektiv), starta kameran, centrera en ljus stjärna och kalibrera. Starta sedan mjuk följning och slå på Guidning."
          }
        }
      }
    },
    "Flip east and west": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spejlvend øst og vest"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
