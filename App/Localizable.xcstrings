            "value": "Sirkumpolaarinen: ei koskaan laske"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirkumpolar: går aldri ned"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Circumpolair: gaat nooit onder"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirkumpolär: går aldrig ner"
          }
        }
      }
    },
    "Clear selection": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd udvalg"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl aufheben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar selección"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjennä valinta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern utvalget"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wis selectie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa urval"
          }
        }
      }
    },
    "Click it, or drag a box around it. A box that fits it closely holds best; one that's mostly water or field follows the water.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på den, eller træk en ramme omkring den. En ramme, der passer tæt, holder bedst; en, der mest er vand eller mark, følger vandet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darauf klicken oder einen Rahmen darum ziehen. Ein eng anliegender Rahmen hält am besten; einer mit viel Wasser oder Feld folgt dem Wasser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en él o arrastrar un recuadro a su alrededor. Un recuadro ajustado lo mantiene mejor; uno que es sobre todo agua o campo sigue el agua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita sitä tai vedä sen ympärille laatikko. Tiukasti rajattu laatikko pitää parhaiten; enimmäkseen vettä tai peltoa sisältävä laatikko seuraa vettä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på den, eller dra en ramme rundt den. En ramme som sitter tett, holder best; en som stort sett er vann eller jorde, følger vannet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik erop of sleep er een kader omheen. Een kader dat er nauw omheen past, houdt het best; een kader met vooral water of veld volgt het water."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på det eller dra en ram runt det. En ram som sluter tätt håller bäst; en som mest innehåller vatten eller fält följer vattnet."
          }
        }
      }
    },
    "Click on a moving object to track it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et objekt i bevægelse for at spore det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein bewegtes Objekt klicken, um es zu verfolgen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en un objeto en movimiento para seguirlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa liikkuvaa kohdetta osoittamalla sitä"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på et objekt i bevegelse for å følge det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een bewegend object om het te volgen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett rörligt objekt för att följa det"
          }
        }
      }
    },
    "Click on something to track it, or drag a box around it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på noget for at spore det, eller træk en ramme omkring det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf etwas klicken, um es zu verfolgen, oder einen Rahmen darum ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en algo para seguirlo o arrastrar un recuadro a su alrededor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa jotakin osoittamalla sitä tai vetämällä sen ympärille laatikko"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på noe for å følge det, eller dra en ramme rundt det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op iets om het te volgen of sleep er een kader omheen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på något för att följa det, eller dra en ram runt det"
          }
        }
      }
    },
    "Click something that isn't moving (a star, a distant light or mast), then calibrate: the mount nudges each axis and watches it move.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på noget, der står stille (en stjerne, et fjernt lys eller en mast), og kalibrer derefter: monteringen skubber let til hver akse og ser, hvordan det flytter sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf etwas Unbewegtes klicken (einen Stern, ein fernes Licht, einen Mast), dann kalibrieren: Die Montierung bewegt jede Achse leicht und beobachtet die Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en algo que no se mueva (una estrella, una luz lejana o un mástil) y calibrar: la montura mueve un poco cada eje y observa cómo se desplaza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita jotakin liikkumatonta (tähteä, kaukaista valoa tai mastoa) ja kalibroi: jalusta liikauttaa kumpaakin akselia ja tarkkailee liikettä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på noe som står stille (en stjerne, et fjernt lys eller en mast), og kalibrer: monteringen dytter hver akse litt og ser det bevege seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op iets dat niet beweegt (een ster, een ver licht of een mast) en kalibreer dan: de montering beweegt elke as een klein stukje en kijkt hoe het beweegt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på något som inte rör sig (en stjärna, ett avlägset ljus eller en mast) och kalibrera sedan: monteringen knuffar varje axel och iakttar hur det rör sig."
          }
        }
      }
    },
    "Click something that isn't moving first (a star, a distant light, mast or building), then calibrate.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik først på noget, der står stille (en stjerne, et fjernt lys, en mast eller en bygning), og kalibrer derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst auf etwas Unbewegtes klicken (einen Stern, ein fernes Licht, einen Mast oder ein Gebäude), dann kalibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic primero en algo que no se mueva (una estrella, una luz lejana, un mástil o un edificio) y después calibrar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita ensin jotakin liikkumatonta (tähteä, kaukaista valoa, mastoa tai rakennusta) ja kalibroi sitten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk først på noe som står stille (en stjerne, et fjernt lys, en mast eller en bygning), og kalibrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik eerst op iets dat niet beweegt (een ster, een ver licht, een mast of een gebouw) en kalibreer dan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka först på något som inte rör sig (en stjärna, ett avlägset ljus, en mast eller en byggnad) och kalibrera sedan."
          }
        }
      }
    },
