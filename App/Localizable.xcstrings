    "The mount refused the slew (below its altitude limit?)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen afviste svingningen (under dens højdegrænse?)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Montierung hat den Schwenk abgelehnt (unter ihrer Höhengrenze?)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La montura rechazó el giro (¿por debajo de su límite de altitud?)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalusta hylkäsi käännön (alle korkeusrajansa?)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen avviste svingen (under høydegrensen?)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De montering weigerde de zwenk (onder de hoogtegrens?)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen vägrade svängningen (under sin höjdgräns?)"
          }
        }
      }
    },
    "The mount stopped answering.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen holdt op med at svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Montierung antwortet nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La montura dejó de responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalusta lakkasi vastaamasta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen sluttet å svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De montering antwoordt niet meer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen slutade svara."
          }
        }
      }
    },
    "The mount stopped tracking (it reports %@)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen stoppede sporingen (den rapporterer %@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Montierung hat die Nachführung beendet (meldet %@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La montura dejó de seguir (indica %@)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalusta lopetti seurannan (se ilmoittaa %@)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen sluttet å følge (den melder %@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De montering is gestopt met volgen (meldt %@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringen slutade följa (den rapporterar %@)"
          }
        }
      }
    },
    "The mount's GPS has no fix, so this is the location last set in the mount: %@.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringens GPS har intet fix, så dette er den lokalitet, der sidst blev indstillet i monteringen: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GPS der Montierung hat keinen Fix, daher ist dies der zuletzt in der Montierung gesetzte Standort: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS de la montura no tiene posición, así que esta es la última ubicación establecida en la montura: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalustan GPS:llä ei ole paikannusta, joten tämä on jalustaan viimeksi asetettu sijainti: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringens GPS har ingen fix, så dette er posisjonen som sist ble lagt inn i monteringen: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De GPS van de montering heeft geen fix, dus dit is de locatie die het laatst in de montering is ingesteld: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringens GPS har ingen fix, så det här är den plats som senast ställdes in i monteringen: %@."
          }
        }
      }
    },
    "The mount's reading": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringens aflæsning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wert der Montierung"
          }
        },
        "es": {
