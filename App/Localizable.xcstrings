          }
        }
      }
    },
    "Carries the location, cable stop, limits, speeds, timing and alignment to another device, by AirDrop or Files. Each device keeps its own connection, camera and appearance.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overfører lokalitet, kabelstop, grænser, hastigheder, timing og justering til en anden enhed via AirDrop eller Filer. Hver enhed beholder sin egen forbindelse, sit eget kamera og udseende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt Standort, Kabelanschlag, Grenzen, Geschwindigkeiten, Timing und Ausrichtung per AirDrop oder Dateien auf ein anderes Gerät. Jedes Gerät behält seine eigene Verbindung, Kamera und Darstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la ubicación, el tope del cable, los límites, las velocidades, la temporización y la alineación a otro dispositivo, por AirDrop o Archivos. Cada dispositivo conserva su propia conexión, cámara y apariencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtää sijainnin, kaapelirajoittimen, rajat, nopeudet, ajoituksen ja kohdistuksen toiseen laitteeseen AirDropilla tai Tiedostoilla. Jokainen laite säilyttää oman yhteytensä, kameransa ja ulkoasunsa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overfører posisjon, kabelstopp, grenser, hastigheter, timing og innretting til en annen enhet med AirDrop eller Filer. Hver enhet beholder sin egen tilkobling, sitt kamera og sitt utseende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt de locatie, kabelaanslag, grenzen, snelheden, timing en uitlijning via AirDrop of Bestanden mee naar een ander apparaat. Elk apparaat houdt zijn eigen verbinding, camera en weergave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För över plats, kabelstopp, gränser, hastigheter, timing och inriktning till en annan enhet via AirDrop eller Filer. Varje enhet behåller sin egen anslutning, kamera och sitt eget utseende."
          }
        }
      }
    },
