            "value": "Casi listo"
          }
        }
      }
    },
    "Never point a telescope, finder or camera at the Sun without a proper full-aperture solar filter. It can blind you instantly and destroy equipment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemals ein Teleskop, einen Sucher oder eine Kamera ohne geeigneten Vollapertur-Sonnenfilter auf die Sonne richten. Das kann sofort zur Erblindung führen und Geräte zerstören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No apuntar nunca un telescopio, buscador o cámara al Sol sin un filtro solar adecuado de apertura completa. Puede causar ceguera al instante y destruir el equipo."
          }
        }
      }
    },
    "Next pass": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächster Überflug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo paso"
          }
        }
      }
    },
    "Night vision: red on black": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachtsicht: Rot auf Schwarz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visión nocturna: rojo sobre negro"
          }
        }
      }
    },
    "No (in shadow or daylight)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein (im Schatten oder bei Tag)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No (en sombra o de día)"
          }
        }
      }
    },
    "No GPS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein GPS"
          }
        },
        "es": {
          "stringUnit": {
