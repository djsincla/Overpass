    "Read on connecting, before Overpass set its location and time. Firmware dates are from the mount.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læst ved tilslutning, før Overpass indstillede dens lokalitet og tid. Firmwaredatoer er fra monteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verbinden gelesen, bevor Overpass Standort und Zeit gesetzt hat. Firmware-Daten stammen von der Montierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído al conectar, antes de que Overpass estableciera su ubicación y hora. Las fechas del firmware proceden de la montura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettu yhdistettäessä, ennen kuin Overpass asetti sijainnin ja ajan. Laiteohjelmiston päivämäärät ovat jalustalta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lest ved tilkobling, før Overpass satte posisjon og tid. Fastvaredatoene kommer fra monteringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen bij het verbinden, voordat Overpass zijn locatie en tijd instelde. Firmwaredatums komen van de montering."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läses vid anslutning, innan Overpass ställt in plats och tid. Firmwaredatum kommer från monteringen."
          }
        }
      }
    },
