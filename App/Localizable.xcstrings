    },
    "Smooth: varies both axis speeds continuously. Best for imaging satellites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitend: variiert beide Achsgeschwindigkeiten kontinuierlich. Am besten für Satellitenaufnahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
