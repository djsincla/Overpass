          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Himmelskörper werden am Himmel markiert und können nachgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuerpos seleccionados se marcan en el cielo y se pueden seguir."
          }
