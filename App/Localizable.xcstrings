    "Passive and Step tracking need the WiFi connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive und schrittweise Nachführung benötigen die WLAN-Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento Pasivo y Por pasos necesita la conexión WiFi."
          }
        }
      }
    },
    "Passive: one goto, then the mount tracks by itself. Stars, planets, Moon, Sun and geostationary satellites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv: ein GoTo, dann führt die Montierung selbst nach. Sterne, Planeten, Mond, Sonne und geostationäre Satelliten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasivo: un goto y después la montura sigue por sí misma. Estrellas, planetas, Luna, Sol y satélites geoestacionarios."
          }
        }
      }
    },
    "Past its start point": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startpunkt überschritten"
          }
        },
        "es": {
