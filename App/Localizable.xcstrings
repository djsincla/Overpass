    "Both axes moved the image the same way; check the camera is fixed to the tube and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge akser flyttede billedet samme vej; kontroller, at kameraet sidder fast på tubussen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Achsen haben das Bild in dieselbe Richtung bewegt; prüfen, ob die Kamera fest am Tubus sitzt, und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos ejes movieron la imagen en el mismo sentido; comprobar que la cámara está fija al tubo y volver a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat akselit liikuttivat kuvaa samaan suuntaan; tarkista, että kamera on kiinni putkessa, ja yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge aksene flyttet bildet samme vei; kontroller at kameraet sitter fast på tuben, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide assen bewogen het beeld dezelfde kant op; controleer of de camera vast aan de tubus zit en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda axlarna flyttade bilden åt samma håll. Kontrollera att kameran sitter fast på tuben och försök igen."
          }
        }
      }
    },
