    "Numbered as on the hand controller. Search by number, such as M13 or C14. Positions and data from OpenNGC.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummereret som på håndkontrollen. Søg efter nummer, f.eks. M13 eller C14. Positioner og data fra OpenNGC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeriert wie auf der Handsteuerbox. Nach Nummer suchen, etwa M13 oder C14. Positionen und Daten von OpenNGC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerados como en el mando de control. Buscar por número, como M13 o C14. Posiciones y datos de OpenNGC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeroitu kuten käsiohjaimessa. Hae numerolla, kuten M13 tai C14. Sijainnit ja tiedot: OpenNGC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummerert som på håndkontrollen. Søk på nummer, for eksempel M13 eller C14. Posisjoner og data fra OpenNGC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genummerd zoals op de handcontroller. Zoek op nummer, zoals M13 of C14. Posities en gegevens van OpenNGC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Numrerade som på handkontrollen. Sök på nummer, till exempel M13 eller C14. Positioner och data från OpenNGC."
          }
        }
      }
    },
