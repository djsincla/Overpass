    "For debugging: keeps the last %lld minutes of tracking and adds an export button to the tracking chart, to save it as CSV": {
      "localizations": {
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Til fejlfinding: gemmer det sidste %lld minut af sporingen og tilføjer en eksportknap til sporingsdiagrammet, så den kan gemmes som CSV"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Til fejlfinding: gemmer de sidste %lld minutter af sporingen og tilføjer en eksportknap til sporingsdiagrammet, så den kan gemmes som CSV"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zur Fehlersuche: behält die letzte %lld Minute der Nachführung und ergänzt das Nachführungsdiagramm um eine Taste zum Export als CSV"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zur Fehlersuche: behält die letzten %lld Minuten der Nachführung und ergänzt das Nachführungsdiagramm um eine Taste zum Export als CSV"
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
