    "Small, medium or large: from the radar cross-section, or else the largest dimension": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lille, mellem eller stor: ud fra radartværsnittet eller ellers den største dimension"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, mittel oder groß: nach Radarquerschnitt, sonst nach größter Abmessung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño, mediano o grande: según la sección eficaz de radar o, si no, la dimensión mayor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieni, keskikoko tai suuri: tutkapoikkipinta-alan mukaan, muuten suurimman mitan mukaan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liten, middels eller stor: ut fra radartverrsnittet, ellers største mål"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, middel of groot: volgens de radardoorsnede, anders de grootste afmeting"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liten, medel eller stor: utifrån radarmålytan, annars största måttet"
          }
        }
      }
    },
    "Smooth": {
      "comment": "Tracking mode: continuously varied axis speeds",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glidende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasainen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiend"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuk"
          }
        }
      }
    },
    "Smooth and camera tracking carry on past north by up to the overtravel, then the mount unwinds when tracking ends. The cables need that much slack.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glidende sporing og kamerasporing fortsætter forbi nord op til overløbet, hvorefter monteringen drejer tilbage, når sporingen slutter. Kablerne skal have så meget slæk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitende und Kameranachführung laufen bis zum Überlauf über Norden hinaus weiter; danach dreht die Montierung zurück, wenn die Nachführung endet. Die Kabel brauchen so viel Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento Suave y por cámara continúa más allá del norte hasta el sobrerrecorrido; después la montura se desenrolla al terminar el seguimiento. Los cables necesitan esa holgura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasainen ja kameraseuranta jatkavat pohjoisen ohi ylikierron verran, ja jalusta kiertää takaisin, kun seuranta päättyy. Kaapeleissa on oltava niin paljon löysää."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn følging og kamerafølging fortsetter forbi nord med opptil overløpet, så ruller monteringen tilbake når følgingen er slutt. Kablene trenger så mye slakk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiend volgen en volgen met camera gaan tot de overloop voorbij het noorden door; daarna draait de montering terug als het volgen stopt. De kabels hebben zoveel speling nodig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuk följning och kameraföljning fortsätter förbi norr upp till övervridningen, och sedan vrider monteringen tillbaka när följningen slutar. Kablarna behöver så mycket slack."
          }
        }
      }
    },
    "Smooth tracking needs a star alignment: centre two or three bright stars": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glidende sporing kræver en stjernejustering: centrer to eller tre klare stjerner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitende Nachführung braucht eine Sternausrichtung: zwei oder drei helle Sterne zentrieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth tracking needs a star alignment: center two or three bright stars"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth tracking needs a star alignment: centre two or three bright stars"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento Suave necesita una alineación con estrellas: centrar dos o tres estrellas brillantes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasainen seuranta vaatii tähtikohdistuksen: keskitä kaksi tai kolme kirkasta tähteä"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn følging krever stjerneinnretting: sentrer to eller tre klare stjerner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiend volgen vereist een steruitlijning: centreer twee of drie heldere sterren"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuk följning kräver stjärninriktning: centrera två eller tre ljusa stjärnor"
          }
        }
      }
    },
    "Smooth tracking needs the USB connection (Special mode).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glidende sporing kræver USB-forbindelsen (specialtilstand)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitende Nachführung benötigt die USB-Verbindung (Spezialmodus)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento Suave necesita la conexión USB (modo Especial)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasainen seuranta vaatii USB-yhteyden (erikoistila)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn følging krever USB-tilkoblingen (spesialmodus)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiend volgen vereist de USB-verbinding (speciale modus)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuk följning kräver USB-anslutningen (specialläge)."
          }
        }
      }
    },
    "Smooth tracking updates": {
