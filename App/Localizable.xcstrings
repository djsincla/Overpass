    "Calibrated. Start Smooth tracking, then turn on Guide to keep the target centred.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreret. Start glidende sporing, og slå derefter Guiding til for at holde målet i midten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibriert. Gleitende Nachführung starten, dann Guiding einschalten, um das Ziel zentriert zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated. Start Smooth tracking, then turn on Guide to keep the target centered."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated. Start Smooth tracking, then turn on Guide to keep the target centred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrado. Iniciar el seguimiento Suave y activar Guiado para mantener el objetivo centrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibroitu. Aloita tasainen seuranta ja kytke sitten Ohjaus päälle pitääksesi kohteen keskellä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrert. Start jevn følging, og slå så på Guiding for å holde målet sentrert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekalibreerd. Start vloeiend volgen en schakel dan Guiden in om het doel gecentreerd te houden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrerad. Starta mjuk följning och slå sedan på Guidning för att hålla målet centrerat."
          }
        }
      }
    },
