        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraadgang er slået fra. Slå den til i Systemindstillinger → Anonymitet og sikkerhed → Kamera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
