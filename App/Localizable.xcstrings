          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne i Kart"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Kaarten"
          }
        },
        "sv": {
