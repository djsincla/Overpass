          "stringUnit": {
            "state": "translated",
            "value": "Activar la Luna o el Sol para buscar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke Kuu tai Aurinko päälle hakeaksesi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på månen eller solen for å søke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de maan of de zon in om te zoeken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på månen eller solen för att söka."
          }
        }
      }
    },
    "Turn on the Space stations source in Objects to get the ISS and Tiangong elements.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå kilden Rumstationer til i Objekter for at få elementerne for ISS og Tiangong."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle „Raumstationen“ unter „Objekte“ aktivieren, um die Elemente von ISS und Tiangong zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la fuente Estaciones espaciales en Objetos para obtener los elementos de la ISS y Tiangong."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke Avaruusasemat-lähde päälle Kohteissa saadaksesi ISS:n ja Tiangongin elementit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på kilden Romstasjoner i Objekter for å få elementene for ISS og Tiangong."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de bron Ruimtestations in bij Objecten om de elementen van het ISS en Tiangong te krijgen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på källan Rymdstationer i Objekt för att få element för ISS och Tiangong."
          }
        }
      }
    },
    "Turn on the Starlink source in Objects, Manage sources, to include them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå kilden Starlink til i Objekter, Administrer kilder, for at tage dem med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle „Starlink“ unter „Objekte“ › „Quellen verwalten“ aktivieren, um sie einzubeziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la fuente Starlink en Objetos, Gestionar fuentes, para incluirlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke Starlink-lähde päälle kohdassa Kohteet, Hallitse lähteitä, ottaaksesi ne mukaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på kilden Starlink i Objekter, Administrer kilder, for å ta dem med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de bron Starlink in bij Objecten, Beheer bronnen, om ze mee te nemen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på källan Starlink i Objekt, Hantera källor, för att ta med dem."
          }
        }
      }
    },
