    "No transits within %@ of %@ in the next %lld days. Try a wider range or more days.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen transitter inden for %1$@ fra %2$@ de næste %3$lld dage. Prøv et større område eller flere dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Transite im Umkreis von %1$@ um %2$@ innerhalb von %3$lld Tagen. Größeren Umkreis oder mehr Tage versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No transits within %1$@ of %2$@ in the next %3$lld days. Try a wider range or more days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tránsitos a menos de %1$@ de %2$@ en los próximos %3$lld días. Probar con un rango más amplio o más días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ylikulkuja %1$@ säteellä kohteesta %2$@ seuraavien %3$lld päivän aikana. Kokeile laajempaa aluetta tai useampaa päivää."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen transitter innenfor %1$@ fra %2$@ de neste %3$lld dagene. Prøv et større område eller flere dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen transits binnen %1$@ van %2$@ in de komende %3$lld dagen. Probeer een groter bereik of meer dagen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga transiter inom %1$@ från %2$@ de närmaste %3$lld dagarna. Prova ett större område eller fler dagar."
          }
        }
      }
    },
    "None of your %lld selected satellites pass in the next %lld hours with these filters.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af dine %1$lld valgte satellitter har en passage de næste %2$lld timer med disse filtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner der %1$lld ausgewählten Satelliten hat mit diesen Filtern innerhalb von %2$lld Stunden einen Überflug."
          }
        },
        "en": {
