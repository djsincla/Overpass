        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avmarkerade %1$lld av %2$lld som aldrig stiger över %3$lld° härifrån de närmaste 7 dagarna: %4$@."
          }
        }
      }
    },
