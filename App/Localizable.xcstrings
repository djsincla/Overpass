    "Cancel tracking or the move to the start point, and stop the mount (Esc)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuller sporingen eller kørslen til startpunktet, og stop monteringen (Esc)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachführung oder Fahrt zum Startpunkt abbrechen und Montierung stoppen (Esc)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar el seguimiento o el movimiento al punto inicial y detener la montura (Esc)"
          }
        },
        "fi": {
