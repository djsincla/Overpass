    "Overpass needs your location to work out what's in your sky.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass skal bruge din lokalitet for at beregne, hvad der er på din himmel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass benötigt den Standort, um zu berechnen, was am Himmel zu sehen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass necesita su ubicación para calcular qué hay en su cielo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass tarvitsee sijaintisi laskeakseen, mitä taivaallasi on."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass trenger posisjonen din for å beregne hva som er på himmelen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass heeft je locatie nodig om te berekenen wat er aan jouw hemel staat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Overpass behöver din plats för att räkna ut vad som finns på din himmel."
          }
        }
      }
    },
