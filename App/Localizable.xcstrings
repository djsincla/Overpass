    "On target the whole pass.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet hele passagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ganzen Überflug auf dem Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el objetivo durante todo el paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteessa koko ylilennon ajan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet hele passeringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele passage op het doel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet hela passagen."
          }
        }
      }
    },
    "On target within": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet inden for"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Ziel innerhalb"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el objetivo en"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteessa viimeistään"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet innen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het doel binnen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På målet inom"
          }
        }
      }
    },
    "Only point a telescope or camera at the Sun with a proper full-aperture solar filter fitted.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret kun et teleskop eller kamera mod Solen med et ordentligt solfilter over hele åbningen monteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleskop oder Kamera nur mit montiertem Vollapertur-Sonnenfilter auf die Sonne richten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apuntar un telescopio o una cámara al Sol solo con un filtro solar adecuado de apertura completa colocado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuntaa kaukoputki tai kamera Aurinkoon vain, kun kunnollinen koko aukon kattava aurinkosuodin on asennettu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek bare et teleskop eller kamera mot solen med et skikkelig solfilter over hele åpningen montert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt een telescoop of camera alleen op de zon met een geschikt zonnefilter over de volle opening."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta bara ett teleskop eller en kamera mot solen med ett riktigt solfilter som täcker hela öppningen."
          }
        }
      }
    },
    "Only with a proper full-aperture solar filter on the scope and finder.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun med et ordentligt solfilter over hele åbningen på teleskop og søger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit geeignetem Vollapertur-Sonnenfilter an Teleskop und Sucher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con un filtro solar adecuado de apertura completa en el telescopio y el buscador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kunnollisella koko aukon kattavalla aurinkosuotimella kaukoputkessa ja etsimessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare med et skikkelig solfilter over hele åpningen på teleskopet og søkeren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen met een geschikt zonnefilter over de volle opening op telescoop en zoeker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara med ett riktigt solfilter över hela öppningen på teleskop och sökare."
          }
        }
      }
    },
    "Open in Maps": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn i Kort"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Karten öffnen"
          }
        },
        "es": {
