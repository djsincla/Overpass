    },
    "Carries the location, cable stop, limits, speeds, timing and alignment to another device, by AirDrop or Files. Each device keeps its own connection, camera and appearance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt Standort, Kabelanschlag, Grenzen, Geschwindigkeiten, Timing und Ausrichtung per AirDrop oder Dateien auf ein anderes Gerät. Jedes Gerät behält seine eigene Verbindung, Kamera und Darstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la ubicación, el tope del cable, los límites, las velocidades, la temporización y la alineación a otro dispositivo, por AirDrop o Archivos. Cada dispositivo conserva su propia conexión, cámara y apariencia."
          }
        }
      }
    },
