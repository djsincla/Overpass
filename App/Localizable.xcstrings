    "%@ from %@° to %@°: arrived after moving %@° (the short way is %@°). %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: fremme efter at have bevæget sig %4$@° (den korte vej er %5$@°). %6$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: nach %4$@° Bewegung angekommen (der kurze Weg ist %5$@°). %6$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: arrived after moving %4$@° (the short way is %5$@°). %6$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: llegó tras moverse %4$@° (el camino corto es %5$@°). %6$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@° → %3$@°: perillä %4$@° liikkeen jälkeen (lyhyt reitti on %5$@°). %6$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: kom fram etter å ha beveget seg %4$@° (den korte veien er %5$@°). %6$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@° naar %3$@°: aangekomen na %4$@° beweging (de korte weg is %5$@°). %6$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ från %2$@° till %3$@°: framme efter att ha rört sig %4$@° (korta vägen är %5$@°). %6$@"
          }
        }
      }
