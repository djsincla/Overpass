          }
        },
        "nb": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "For feilsøking: beholder det siste %lld minuttet av følgingen og legger til en eksportknapp i følgingsdiagrammet for å lagre det som CSV"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "For feilsøking: beholder de siste %lld minuttene av følgingen og legger til en eksportknapp i følgingsdiagrammet for å lagre det som CSV"
                }
              }
            }
          }
        },
        "nl": {
