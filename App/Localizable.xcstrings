    "Never point a telescope, finder or camera at the Sun without a proper full-aperture solar filter. It can blind you instantly and destroy equipment.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret aldrig et teleskop, en søger eller et kamera mod Solen uden et ordentligt solfilter over hele åbningen. Det kan gøre dig blind på et øjeblik og ødelægge udstyr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemals ein Teleskop, einen Sucher oder eine Kamera ohne geeigneten Vollapertur-Sonnenfilter auf die Sonne richten. Das kann sofort zur Erblindung führen und Geräte zerstören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No apuntar nunca un telescopio, buscador o cámara al Sol sin un filtro solar adecuado de apertura completa. Puede causar ceguera al instante y destruir el equipo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä koskaan suuntaa kaukoputkea, etsintä tai kameraa Aurinkoon ilman kunnollista koko aukon kattavaa aurinkosuodinta. Se voi sokaista sinut välittömästi ja tuhota laitteet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek aldri et teleskop, en søker eller et kamera mot solen uten et skikkelig solfilter over hele åpningen. Det kan gjøre deg blind på et øyeblikk og ødelegge utstyret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt nooit een telescoop, zoeker of camera op de zon zonder een geschikt zonnefilter over de volle opening. Het kan je direct blind maken en apparatuur vernielen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta aldrig ett teleskop, en sökare eller en kamera mot solen utan ett riktigt solfilter som täcker hela öppningen. Det kan blinda dig direkt och förstöra utrustning."
          }
        }
      }
    },
