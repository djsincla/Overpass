    "Nothing in the next %lld days with these settings. Try a lower peak or more days.": {
      "localizations": {
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Intet inden for %lld dag med disse indstillinger. Prøv en lavere kulmination eller flere dage."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Intet de næste %lld dage med disse indstillinger. Prøv en lavere kulmination eller flere dage."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit diesen Einstellungen nichts innerhalb von %lld Tag. Niedrigere Kulmination oder mehr Tage versuchen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit diesen Einstellungen nichts innerhalb von %lld Tagen. Niedrigere Kulmination oder mehr Tage versuchen."
