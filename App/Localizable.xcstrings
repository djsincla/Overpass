    "Can't see a bright spot near the centre. Centre a bright star and check focus and exposure.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke se et klart punkt nær midten. Centrer en klar stjerne, og kontroller fokus og eksponering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein heller Punkt nahe der Mitte. Einen hellen Stern zentrieren und Fokus und Belichtung prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't see a bright spot near the center. Center a bright star and check focus and exposure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't see a bright spot near the centre. Centre a bright star and check focus and exposure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ve ningún punto brillante cerca del centro. Centrar una estrella brillante y revisar el enfoque y la exposición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirkasta pistettä ei näy lähellä keskustaa. Keskitä kirkas tähti ja tarkista tarkennus ja valotus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner ingen klar lysprikk nær midten. Sentrer en klar stjerne, og kontroller fokus og eksponering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen helder punt bij het midden te zien. Centreer een heldere ster en controleer focus en belichting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser ingen ljus punkt nära mitten. Centrera en ljus stjärna och kontrollera fokus och exponering."
          }
        }
      }
    },
    "Can't track: exceeds the altitude limits": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke spore: uden for højdegrænserne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachführung nicht möglich: außerhalb der Höhengrenzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede seguir: supera los límites de altitud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voi seurata: ylittää korkeusrajat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke følge: utenfor høydegrensene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet volgen: buiten de hoogtegrenzen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte följa: utanför höjdgränserna"
          }
        }
      }
    },
    "Can't turn further that way: cable stop": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke dreje længere den vej: kabelstop"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht weiter in diese Richtung: Kabelanschlag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede girar más en ese sentido: tope del cable"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voi kääntyä pidemmälle tuohon suuntaan: kaapelirajoitin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke dreie lenger den veien: kabelstopp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet verder die kant op: kabelaanslag"
          }
        },
        "sv": {
