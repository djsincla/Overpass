    "%@ from %@° to %@°: arrived after moving %@° (the short way is %@°). %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: nach %4$@° Bewegung angekommen (der kurze Weg ist %5$@°). %6$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: arrived after moving %4$@° (the short way is %5$@°). %6$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: llegó tras moverse %4$@° (el camino corto es %5$@°). %6$@"
          }
        }
      }
    },
    "%@ from %@° to %@°: hadn't arrived after 15 s, moved %@°, stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: nach 15 s nicht angekommen, %4$@° bewegt, gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: hadn't arrived after 15 s, moved %4$@°, stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: no había llegado tras 15 s, se movió %4$@°, detenido."
          }
        }
      }
    },
    "%@ from %@° to %@°: went the wrong way (%@° when the short way is %@°), stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: in die falsche Richtung (%4$@°, der kurze Weg ist %5$@°), gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: went the wrong way (%4$@° when the short way is %5$@°), stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: fue en la dirección equivocada (%4$@° cuando el camino corto es %5$@°), detenido."
          }
        }
      }
    },
    "%@ is centred: shift Overpass's alignment so the scope reads it. Nothing is sent to the mount.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zentriert: Ausrichtung von Overpass so verschieben, dass das Teleskop darauf steht. An die Montierung wird nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está centrado: desplazar la alineación de Overpass para que el telescopio lo lea. No se envía nada a la montura."
          }
        }
      }
    },
    "%@ is centred: tell the mount (:CM#), then read its position back to check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zentriert: der Montierung melden (:CM#), dann zur Kontrolle ihre Position zurücklesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está centrado: comunicarlo a la montura (:CM#) y leer su posición para comprobarlo."
          }
        }
      }
    },
