            "value": "Akselit näyttävät nyt %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksene viser nå %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assen geven nu %@ aan."
          }
        },
        "sv": {
