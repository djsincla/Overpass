    "Centre a bright star with tracking stopped; the mount nudges each axis and watches the image.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrer en klar stjerne med sporingen stoppet; monteringen skubber let til hver akse og holder øje med billedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei gestoppter Nachführung einen hellen Stern zentrieren; die Montierung bewegt jede Achse leicht und beobachtet das Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center a bright star with tracking stopped; the mount nudges each axis and watches the image."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Centre a bright star with tracking stopped; the mount nudges each axis and watches the image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrar una estrella brillante con el seguimiento detenido; la montura mueve un poco cada eje y observa la imagen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskitä kirkas tähti seurannan ollessa pysäytettynä; jalusta liikauttaa kumpaakin akselia ja tarkkailee kuvaa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentrer en klar stjerne med følgingen stoppet; monteringen dytter hver akse litt og ser på bildet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centreer een heldere ster met het volgen gestopt; de montering beweegt elke as een klein stukje en kijkt naar het beeld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrera en ljus stjärna med följningen stoppad; monteringen knuffar varje axel och iakttar bilden."
          }
        }
      }
    },
    "Centre on your location": {
