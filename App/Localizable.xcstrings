    "Normal mode, synced on %@, but %@. In the mount log.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaltilstand, synkroniseret på %1$@, men %2$@. I monteringsloggen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, synchronisiert auf %1$@, aber %2$@. Im Montierungsprotokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Normal mode, synced on %1$@, but %2$@. In the mount log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal, sincronizado con %1$@, pero %2$@. Ver el registro de la montura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaalitila, synkronoitu kohteeseen %1$@, mutta %2$@. Katso jalustan loki."
          }
        },
        "nb": {
