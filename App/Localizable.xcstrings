    "Passive and Step tracking need the WiFi connection.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv og trinvis sporing kræver Wi-Fi-forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive und schrittweise Nachführung benötigen die WLAN-Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento Pasivo y Por pasos necesita la conexión WiFi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiivinen ja askelseuranta vaativat WiFi-yhteyden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv og trinnvis følging krever Wi-Fi-tilkoblingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passief en stapsgewijs volgen vereisen de wifiverbinding."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv följning och stegföljning kräver Wi-Fi-anslutningen."
          }
        }
      }
    },
    "Passive: one goto, then the mount tracks by itself. Stars, planets, Moon, Sun and geostationary satellites.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv: én goto, derefter sporer monteringen selv. Stjerner, planeter, Månen, Solen og geostationære satellitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv: ein GoTo, dann führt die Montierung selbst nach. Sterne, Planeten, Mond, Sonne und geostationäre Satelliten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasivo: un goto y después la montura sigue por sí misma. Estrellas, planetas, Luna, Sol y satélites geoestacionarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiivinen: yksi goto, sitten jalusta seuraa itse. Tähdet, planeetat, Kuu, Aurinko ja geostationaariset satelliitit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv: én goto, så følger monteringen selv. Stjerner, planeter, månen, solen og geostasjonære satellitter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passief: één goto, daarna volgt de montering zelf. Sterren, planeten, maan, zon en geostationaire satellieten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Passiv: en goto, sedan följer monteringen själv. Stjärnor, planeter, månen, solen och geostationära satelliter."
          }
        }
      }
    },
