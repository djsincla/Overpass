    "Lost it. Click it again to pick it up.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistede den. Klik på den igen for at fange den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloren. Erneut anklicken, um es wieder zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha perdido. Hacer clic de nuevo para recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadotettu. Osoita sitä uudelleen ottaaksesi sen kiinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet den. Klikk på den igjen for å fange den opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwijt. Klik er opnieuw op om het weer op te pakken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tappade det. Klicka på det igen för att plocka upp det."
          }
        }
      }
    },
    "Lost the target. Click it again to pick it up.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistede målet. Klik på det igen for at fange det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel verloren. Erneut anklicken, um es wieder zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha perdido el objetivo. Hacer clic de nuevo para recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohde kadotettu. Osoita sitä uudelleen ottaaksesi sen kiinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet målet. Klikk på det igjen for å fange det opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doel kwijt. Klik er opnieuw op om het weer op te pakken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tappade målet. Klicka på det igen för att plocka upp det."
          }
        }
      }
    },
    "Lost the target; holding the last corrections": {
