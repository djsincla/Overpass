    "Locked on it. If it slips, drag a box around it instead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på den. Hvis den glider, så træk i stedet en ramme omkring den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst. Falls es verrutscht, stattdessen einen Rahmen darum ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado. Si se escapa, arrastrar un recuadro a su alrededor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukittu. Jos se lipsuu, vedä sen ympärille laatikko."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på den. Hvis den glipper, dra heller en ramme rundt den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendeld. Als het wegglijdt, sleep er dan een kader omheen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på det. Om det glider undan, dra en ram runt det i stället."
          }
        }
      }
    },
    "Locked on the area clicked. Drag a box around the object for a closer fit.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på det klikkede område. Træk en ramme omkring objektet for en tættere tilpasning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeklickten Bereich erfasst. Für eine engere Erfassung einen Rahmen um das Objekt ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado en la zona pulsada. Arrastrar un recuadro alrededor del objeto para un ajuste más preciso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukittu osoitettuun alueeseen. Vedä laatikko kohteen ympärille tarkempaa rajausta varten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på området du klikket. Dra en ramme rundt objektet for tettere tilpasning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendeld op het aangeklikte gebied. Sleep een kader om het object voor een nauwere passing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst på det klickade området. Dra en ram runt objektet för en tätare passning."
          }
        }
      }
    },
