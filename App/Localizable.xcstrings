    "CelesTrak asks for at least 2 hours between downloads. Try again after %@.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak beder om mindst 2 timer mellem downloads. Prøv igen efter %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak verlangt mindestens 2 Stunden zwischen Downloads. Nach %@ erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak pide al menos 2 horas entre descargas. Volver a intentarlo después de las %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak edellyttää vähintään 2 tuntia latausten välillä. Yritä uudelleen klo %@ jälkeen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak ber om minst 2 timer mellom nedlastinger. Prøv igjen etter %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak vraagt minstens 2 uur tussen downloads. Probeer het opnieuw na %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CelesTrak vill ha minst 2 timmar mellan nedladdningar. Försök igen efter %@."
          }
        }
      }
    },
