            "value": "Kuinka korkealla Kuun tai Auringon on oltava"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor høyt månen eller solen må stå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe hoog de maan of zon moet staan"
          }
        },
        "sv": {
          "stringUnit": {
