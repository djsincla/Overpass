            "value": "Jalustan lukema"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteringens avlesning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarde van de montering"
          }
        },
        "sv": {
          "stringUnit": {
