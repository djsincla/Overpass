    "Hold freezes the camera's exposure where it is, so a bright object coming into view doesn't darken everything else": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fastfryser kameraets eksponering, hvor den er, så et lyst objekt, der kommer ind i billedet, ikke gør alt andet mørkere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Halten“ friert die Belichtung der Kamera ein, damit ein helles Objekt im Bild nicht alles andere abdunkelt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar congela la exposición de la cámara donde está, para que un objeto brillante que entra en el campo no oscurezca todo lo demás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitse jäädyttää kameran valotuksen nykyiseen arvoon, jotta näkyviin tuleva kirkas kohde ei tummenna kaikkea muuta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold låser kameraets eksponering der den er, så et klart objekt som kommer inn i bildet, ikke gjør alt annet mørkere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Houd vast’ bevriest de belichting van de camera, zodat een helder object dat in beeld komt niet de rest donkerder maakt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås fryser kamerans exponering där den är, så att ett ljust objekt som kommer in i bilden inte gör allt annat mörkare"
          }
        }
      }
    },
    "Hold to move, release to stop": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for at flytte, slip for at stoppe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten zum Bewegen, loslassen zum Stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado para mover, soltar para detener"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painettuna liikuttaaksesi, päästä irti pysäyttääksesi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for å flytte, slipp for å stoppe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt om te bewegen, laat los om te stoppen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ner för att flytta, släpp för att stoppa"
          }
        }
      }
    },
