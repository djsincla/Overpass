    "Off target for about %@ s, at most %@° behind.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden for målet i omkring %1$@ s, højst %2$@° bagud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %1$@ s neben dem Ziel, höchstens %2$@° zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Off target for about %1$@ s, at most %2$@° behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera del objetivo durante unos %1$@ s, con un retraso máximo de %2$@°."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohi kohteen noin %1$@ s, enintään %2$@° jäljessä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenfor målet i omtrent %1$@ s, høyst %2$@° bak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer %1$@ s naast het doel, hoogstens %2$@° achter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utanför målet i ungefär %1$@ s, som mest %2$@° efter."
          }
        }
      }
    },
    "Off: set the exposure yourself. Long exposures and high gain bring up faint satellites; short ones keep the ISS or the Moon from burning out.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra: indstil selv eksponeringen. Lange eksponeringer og høj forstærkning fremhæver svage satellitter; korte forhindrer, at ISS eller Månen brænder ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Belichtung selbst einstellen. Lange Belichtungen und hohe Verstärkung zeigen lichtschwache Satelliten; kurze verhindern, dass ISS oder Mond ausbrennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: ajustar la exposición manualmente. Las exposiciones largas y la ganancia alta revelan satélites débiles; las cortas evitan que la ISS o la Luna se saturen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois: aseta valotus itse. Pitkät valotukset ja suuri vahvistus tuovat esiin himmeät satelliitit; lyhyet estävät ISS:ää tai Kuuta palamasta puhki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av: still inn eksponeringen selv. Lange eksponeringer og høy forsterkning får fram svake satellitter; korte hindrer at ISS eller månen blir overeksponert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit: stel de belichting zelf in. Lange belichtingen en hoge versterking tonen zwakke satellieten; korte voorkomen dat het ISS of de maan overbelicht raakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av: ställ in exponeringen själv. Långa exponeringar och hög förstärkning tar fram ljussvaga satelliter; korta hindrar ISS eller månen från att bli överexponerade."
          }
        }
      }
    },
