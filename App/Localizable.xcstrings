    "%lld brighter than magnitude %lld, the first 2,000 shown. Search by number, such as NGC 891 or IC 434, to go straight to one. Positions and data from OpenNGC.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lysere end magnitude %2$lld, de første 2.000 vist. Søg efter nummer, f.eks. NGC 891 eller IC 434, for at gå direkte til et. Positioner og data fra OpenNGC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld heller als Größenklasse %2$lld, die ersten 2.000 angezeigt. Nach Nummer suchen, etwa NGC 891 oder IC 434, um direkt dorthin zu gelangen. Positionen und Daten von OpenNGC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld brighter than magnitude %2$lld, the first 2,000 shown. Search by number, such as NGC 891 or IC 434, to go straight to one. Positions and data from OpenNGC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld más brillantes que la magnitud %2$lld; se muestran los primeros 2000. Buscar por número, como NGC 891 o IC 434, para ir directamente a uno. Posiciones y datos de OpenNGC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kirkkaampaa kuin magnitudi %2$lld, ensimmäiset 2 000 näytetään. Hae numerolla, kuten NGC 891 tai IC 434, siirtyäksesi suoraan kohteeseen. Sijainnit ja tiedot: OpenNGC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lysere enn størrelsesklasse %2$lld, de første 2 000 vises. Søk på nummer, for eksempel NGC 891 eller IC 434, for å gå rett til ett. Posisjoner og data fra OpenNGC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld helderder dan magnitude %2$lld, de eerste 2.000 getoond. Zoek op nummer, zoals NGC 891 of IC 434, om er direct naartoe te gaan. Posities en gegevens van OpenNGC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ljusare än magnitud %2$lld, de första 2 000 visas. Sök på nummer, till exempel NGC 891 eller IC 434, för att gå direkt till ett. Positioner och data från OpenNGC."
          }
        }
      }
    },
