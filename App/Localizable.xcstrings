    "%@ crosses north, which the mount doesn't turn through. Going the long way round takes about %lld s, then tracking carries on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ quert Norden, wo die Montierung nicht durchdreht. Der lange Weg dauert etwa %2$lld s, dann geht die Nachführung weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ crosses north, which the mount doesn't turn through. Going the long way round takes about %2$lld s, then tracking carries on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cruza el norte, por donde la montura no gira. Dar la vuelta larga lleva unos %2$lld s; después continúa el seguimiento."
          }
        }
      }
    },
    "%@ d": {
      "comment": "Days, abbreviated",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ T"
