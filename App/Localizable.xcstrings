    "%@ from %@° to %@°: hadn't arrived after 15 s, moved %@°, stopped.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: ikke fremme efter 15 s, bevægede sig %4$@°, stoppede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: nach 15 s nicht angekommen, %4$@° bewegt, gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: hadn't arrived after 15 s, moved %4$@°, stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: no había llegado tras 15 s, se movió %4$@°, detenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@° → %3$@°: ei perillä 15 s jälkeen, liikkui %4$@°, pysäytetty."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: ikke fram etter 15 s, beveget seg %4$@°, stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@° naar %3$@°: na 15 s niet aangekomen, %4$@° bewogen, gestopt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ från %2$@° till %3$@°: inte framme efter 15 s, rörde sig %4$@°, stoppad."
          }
        }
      }
    },
    "%@ from %@° to %@°: went the wrong way (%@° when the short way is %@°), stopped.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: kørte den forkerte vej (%4$@°, når den korte vej er %5$@°), stoppede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@° nach %3$@°: in die falsche Richtung (%4$@°, der kurze Weg ist %5$@°), gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ from %2$@° to %3$@°: went the wrong way (%4$@° when the short way is %5$@°), stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@° a %3$@°: fue en la dirección equivocada (%4$@° cuando el camino corto es %5$@°), detenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@° → %3$@°: liikkui väärään suuntaan (%4$@°, lyhyt reitti on %5$@°), pysäytetty."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fra %2$@° til %3$@°: gikk feil vei (%4$@° når den korte veien er %5$@°), stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@° naar %3$@°: verkeerde kant op (%4$@° terwijl de korte weg %5$@° is), gestopt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ från %2$@° till %3$@°: gick åt fel håll (%4$@° när korta vägen är %5$@°), stoppad."
          }
        }
      }
    },
    "%@ is centred: shift Overpass's alignment so the scope reads it. Nothing is sent to the mount.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er i midten: flyt Overpass' justering, så teleskopet peger på den. Intet sendes til monteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zentriert: Ausrichtung von Overpass so verschieben, dass das Teleskop darauf steht. An die Montierung wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is centered: shift Overpass's alignment so the scope reads it. Nothing is sent to the mount."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is centred: shift Overpass's alignment so the scope reads it. Nothing is sent to the mount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está centrado: desplazar la alineación de Overpass para que el telescopio lo lea. No se envía nada a la montura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on keskellä: siirrä Overpassin kohdistusta niin, että kaukoputki osoittaa siihen. Jalustalle ei lähetetä mitään."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er sentrert: forskyv innrettingen i Overpass slik at teleskopet peker dit. Ingenting sendes til monteringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gecentreerd: verschuif de uitlijning van Overpass zodat de telescoop erop staat. Er wordt niets naar de montering gestuurd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är centrerad: flytta Overpass inriktning så att teleskopet läser den. Inget skickas till monteringen."
          }
        }
      }
    },
    "%@ is centred: tell the mount (:CM#), then read its position back to check.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er i midten: meld det til monteringen (:CM#), og læs derefter dens position tilbage for at kontrollere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zentriert: der Montierung melden (:CM#), dann zur Kontrolle ihre Position zurücklesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is centered: tell the mount (:CM#), then read its position back to check."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is centred: tell the mount (:CM#), then read its position back to check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está centrado: comunicarlo a la montura (:CM#) y leer su posición para comprobarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on keskellä: ilmoita jalustalle (:CM#) ja lue sen sijainti takaisin tarkistusta varten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er sentrert: si fra til monteringen (:CM#), og les så posisjonen tilbake for å kontrollere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gecentreerd: meld het aan de montering (:CM#) en lees ter controle de positie terug."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är centrerad: meddela monteringen (:CM#) och läs sedan tillbaka dess position för att kontrollera."
          }
        }
      }
    },
