    "Spread the picture's darkest to brightest across the full range; lifts a faint night sky": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spred billedets mørkeste til lyseste over hele området; løfter en svag nattehimmel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild vom dunkelsten bis zum hellsten Wert über den vollen Bereich strecken; hebt einen schwachen Nachthimmel an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir de lo más oscuro a lo más brillante de la imagen en todo el rango; realza un cielo nocturno débil"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levitä kuvan tummin ja kirkkain koko alueelle; nostaa himmeää yötaivasta esiin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spre bildet fra mørkeste til lyseste over hele området; løfter fram en svak nattehimmel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rek het beeld van donkerst tot helderst uit over het volle bereik; haalt een zwakke nachthemel op"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprid bildens mörkaste till ljusaste över hela omfånget; lyfter fram en svag natthimmel"
          }
        }
      }
    },
