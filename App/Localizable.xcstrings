    "Sky: a satellite or aircraft, a spot against plain sky. Ground: a boat, bird, car or person, matched by its look against any background.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmel: en satellit eller et fly, et punkt mod klar himmel. Jord: en båd, fugl, bil eller person, genkendt på udseendet mod enhver baggrund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmel: ein Satellit oder Flugzeug, ein Punkt vor freiem Himmel. Boden: ein Boot, Vogel, Auto oder Mensch, erkannt am Aussehen vor beliebigem Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cielo: un satélite o avión, un punto sobre cielo despejado. Suelo: un barco, pájaro, coche o persona, reconocido por su aspecto sobre cualquier fondo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taivas: satelliitti tai lentokone, piste tyhjää taivasta vasten. Maa: vene, lintu, auto tai ihminen, tunnistetaan ulkonäöstä millä tahansa taustalla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmel: en satellitt eller et fly, en prikk mot klar himmel. Bakke: en båt, fugl, bil eller person, gjenkjent på utseendet mot enhver bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemel: een satelliet of vliegtuig, een punt tegen een egale hemel. Grond: een boot, vogel, auto of persoon, herkend aan het uiterlijk tegen elke achtergrond."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmel: en satellit eller ett flygplan, en punkt mot fri himmel. Mark: en båt, fågel, bil eller person, som känns igen på utseendet mot vilken bakgrund som helst."
          }
        }
      }
    },
    "Slew at full speed to where the pass first reaches the start elevation, and wait there": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sving med fuld hastighed derhen, hvor passagen først når starthøjden, og vent der"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit voller Geschwindigkeit dorthin schwenken, wo der Überflug die Starthöhe erstmals erreicht, und dort warten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a máxima velocidad al punto donde el paso alcanza la elevación inicial y esperar allí"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käänny täydellä nopeudella kohtaan, jossa ylilento ensimmäisen kerran saavuttaa aloituselevaation, ja odota siellä"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sving med full hastighet dit passeringen først når starthøyden, og vent der"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwenk op volle snelheid naar waar de passage voor het eerst de startelevatie bereikt, en wacht daar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sväng i full fart dit passagen först når startelevationen och vänta där"
          }
        }
      }
    },
