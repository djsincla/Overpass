            "value": "Den passagen är redan förbi sin startpunkt."
          }
        }
      }
    },
    "The axes now read %@.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Akserne viser nu %@."
          }
        },
        "de": {
