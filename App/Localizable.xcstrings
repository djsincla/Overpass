            "value": "Hacer clic en la imagen donde apunta el telescopio, si no es el centro (un buscador o una cámara junto al tubo)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita kuvasta kohtaa, johon kaukoputki osoittaa, jos se ei ole keskellä (etsin tai kamera putken vieressä)"
          }
        },
        "nb": {
