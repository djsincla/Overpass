    "Red mode draws everything in red on black so your eyes stay dark-adapted. Also turn your screen brightness down.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rød tilstand tegner alt i rødt på sort, så dine øjne forbliver mørketilpassede. Skru også ned for skærmens lysstyrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rotmodus zeichnet alles rot auf Schwarz, damit die Augen dunkeladaptiert bleiben. Zusätzlich die Bildschirmhelligkeit verringern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo rojo dibuja todo en rojo sobre negro para que la vista siga adaptada a la oscuridad. Bajar también el brillo de la pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punainen tila piirtää kaiken punaisella mustalle, jotta silmäsi pysyvät pimeään sopeutuneina. Himmennä myös näytön kirkkautta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rødmodus tegner alt i rødt på svart, så øynene holder seg mørketilpasset. Skru også ned skjermlysstyrken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rode modus tekent alles rood op zwart, zodat je ogen aan het donker aangepast blijven. Zet ook de helderheid van je scherm lager."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rött läge ritar allt i rött på svart så att ögonen förblir mörkeranpassade. Sänk också skärmens ljusstyrka."
          }
        }
      }
    },
