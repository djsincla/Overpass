    "Fine: %lld′ %@. Shifts the tracking offsets while Step or Smooth tracking; otherwise a short slow move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fein: %1$lld′ %2$@. Verschiebt bei schrittweiser oder gleitender Nachführung die Offsets; sonst eine kurze, langsame Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Fine: %1$lld′ %2$@. Shifts the tracking offsets while Step or Smooth tracking; otherwise a short slow move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino: %1$lld′ %2$@. Desplaza las compensaciones del seguimiento durante el seguimiento Por pasos o Suave; si no, un movimiento corto y lento."
          }
        }
      }
    },
    "Fix the iPhone to the tube (3× or 5× lens), start the camera, centre a bright star, and calibrate. Then start Smooth tracking and turn on Guide.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone am Tubus befestigen (3×- oder 5×-Objektiv), Kamera starten, hellen Stern zentrieren und kalibrieren. Dann gleitende Nachführung starten und Guiding einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar el iPhone al tubo (lente 3× o 5×), iniciar la cámara, centrar una estrella brillante y calibrar. Después iniciar el seguimiento Suave y activar Guiado."
          }
        }
      }
    },
