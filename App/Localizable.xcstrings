    "Smooth: varies both axis speeds continuously. Best for imaging satellites.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glidende: ændrer begge akseres hastighed løbende. Bedst til at fotografere satellitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitend: variiert beide Achsgeschwindigkeiten kontinuierlich. Am besten für Satellitenaufnahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave: varía continuamente la velocidad de ambos ejes. Lo mejor para fotografiar satélites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasainen: muuttaa kummankin akselin nopeutta jatkuvasti. Paras satelliittien kuvaamiseen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn: endrer begge aksehastighetene kontinuerlig. Best for å fotografere satellitter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiend: varieert beide assnelheden doorlopend. Het beste voor satellietfotografie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuk: varierar båda axlarnas hastighet kontinuerligt. Bäst för att fotografera satelliter."
          }
        }
      }
    },
