            "value": "Vælg satellitter på fanen Objekter, så vises deres passager her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Satelliten im Tab „Objekte“ wählen, dann erscheinen hier ihre Überflüge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
