    " · goes the long way round at %@, where it crosses the cable stop": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " · tager den lange vej rundt ved %@, hvor den krydser kabelstoppet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · nimmt bei %@ den langen Weg um den Kabelanschlag herum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · da la vuelta larga a las %@, donde cruza el tope del cable"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " · kiertää pitkän reitin kohdassa %@, jossa se ylittää kaapelirajoittimen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": " · tar den lange veien rundt ved %@, der den krysser kabelstoppet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " · neemt bij %@ de lange weg om de kabelaanslag heen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " · tar långa vägen runt vid %@, där den passerar kabelstoppet"
          }
        }
      }
    },
