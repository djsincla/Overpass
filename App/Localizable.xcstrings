    "Circumpolar: never sets": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zirkumpolar: geht nie unter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Circumpolar: nunca se pone"
