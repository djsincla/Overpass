    "Hidden objects are left out of the lists, searches and Look Up. Show one to list it again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte objekter udelades fra lister, søgninger og Kig op. Vis et for at få det på listen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Objekte fehlen in den Listen, in der Suche und unter „Himmel“. Mit „Anzeigen“ wieder in die Listen aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetos ocultos no aparecen en las listas, las búsquedas ni en Mirar arriba. Mostrar uno para que vuelva a aparecer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotetut kohteet jätetään pois luetteloista, hauista ja Katso ylös -näkymästä. Näytä kohde lisätäksesi sen takaisin luetteloon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte objekter utelates fra listene, søkene og Se opp. Vis et objekt for å føre det opp igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen objecten worden weggelaten uit de lijsten, zoekresultaten en Kijk omhoog. Toon een object om het weer in de lijst op te nemen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda objekt utelämnas i listorna, sökningar och Titta upp. Visa ett för att lista det igen."
          }
        }
      }
    },
