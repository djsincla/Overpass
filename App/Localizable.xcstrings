    },
    "No camera found. For an iPhone: keep it near the Mac, unlocked, signed in to the same Apple ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kamera gefunden. Für ein iPhone: in der Nähe des Mac, entsperrt und mit derselben Apple-ID angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cámara. Para un iPhone: mantenerlo cerca del Mac, desbloqueado y con la sesión iniciada en el mismo Apple ID."
          }
        }
      }
    },
    "No comet elements yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kometenelemente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay elementos de cometas"
          }
        }
      }
    },
    "No location yet: set one in Settings, or search for a place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Standort: in den Einstellungen festlegen oder nach einem Ort suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ubicación: establecer una en Ajustes o buscar un lugar."
          }
        }
      }
    },
    "No passes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Überflüge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pasos"
          }
        }
      }
    },
    "No passes coming up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine anstehenden Überflüge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pasos próximos"
          }
        }
      }
    },
    "No position from the mount.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Position von der Montierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin posición de la montura."
          }
        }
      }
    },
    "No satellite in this set is up within 15° of there. The phone's compass can be well out; hold it away from metal and try again, or turn on more sources in Objects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Satellit dieser Auswahl steht innerhalb von 15° dieser Richtung. Der Kompass des Telefons kann deutlich abweichen; von Metall fernhalten und erneut versuchen oder unter „Objekte“ weitere Quellen aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún satélite de este conjunto está a menos de 15° de allí. La brújula del teléfono puede estar muy desviada; alejarlo de objetos metálicos y volver a intentarlo, o activar más fuentes en Objetos."
          }
        }
      }
    },
    "No satellites shown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Satelliten angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestran satélites"
          }
        }
      }
    },
    "No selected satellites to check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine ausgewählten Satelliten zum Prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay satélites seleccionados para comprobar."
          }
        }
      }
    },
    "No space station elements yet: turn on the Space stations source in Objects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Raumstations-Elemente: Quelle „Raumstationen“ unter „Objekte“ aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay elementos de estaciones espaciales: activar la fuente Estaciones espaciales en Objetos."
          }
        }
      }
    },
    "No spot near the centre": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Punkt nahe der Mitte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún punto cerca del centro"
          }
        }
      }
    },
    "No target set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ziel gesetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin objetivo"
          }
        }
      }
    },
    "No transits within %@ of %@ in the next %lld days. Try a wider range or more days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Transite im Umkreis von %1$@ um %2$@ innerhalb von %3$lld Tagen. Größeren Umkreis oder mehr Tage versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No transits within %1$@ of %2$@ in the next %3$lld days. Try a wider range or more days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tránsitos a menos de %1$@ de %2$@ en los próximos %3$lld días. Probar con un rango más amplio o más días."
          }
        }
      }
    },
    "None of your %lld selected satellites pass in the next %lld hours with these filters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner der %1$lld ausgewählten Satelliten hat mit diesen Filtern innerhalb von %2$lld Stunden einen Überflug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "None of your %1$lld selected satellites pass in the next %2$lld hours with these filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno de sus %1$lld satélites seleccionados pasa en las próximas %2$lld horas con estos filtros."
          }
        }
      }
    },
    "None yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno aún"
          }
        }
      }
    },
    "Normal": {
      "comment": "How the mount follows a pass",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        }
      }
    },
    "Normal mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal"
          }
        }
      }
    },
    "Normal mode (WiFi or USB): how often the position is read while idle, and the shortest Step tracking interval. Sub-second commands have caused trouble on the HAZ46 in Normal mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus (WLAN oder USB): wie oft die Position im Ruhezustand gelesen wird, und das kürzeste Intervall der schrittweisen Nachführung. Befehle unter einer Sekunde haben im Normalmodus auf der HAZ46 Probleme verursacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal (WiFi o USB): frecuencia de lectura de la posición en reposo e intervalo mínimo del seguimiento Por pasos. Los comandos de menos de un segundo han causado problemas en la HAZ46 en modo Normal."
          }
        }
      }
    },
    "Normal mode over the mount's USB port: Passive and Step tracking, as over WiFi. If the mount is in Special mode it leaves it, and its position is carried across.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus über den USB-Port der Montierung: passive und schrittweise Nachführung wie über WLAN. Ist die Montierung im Spezialmodus, verlässt sie ihn, und ihre Position wird übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal por el puerto USB de la montura: seguimiento Pasivo y Por pasos, como por WiFi. Si la montura está en modo Especial, sale de él y conserva su posición."
          }
        }
      }
    },
    "Normal mode over the mount's WiFi: Passive and Step tracking. Join the mount's WiFi network first. 10.10.100.254:8899 is iOptron's usual address; check your manual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus über das WLAN der Montierung: passive und schrittweise Nachführung. Zuerst mit dem WLAN der Montierung verbinden. 10.10.100.254:8899 ist die übliche Adresse von iOptron; siehe Handbuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal por la WiFi de la montura: seguimiento Pasivo y Por pasos. Conectarse primero a la red WiFi de la montura. 10.10.100.254:8899 es la dirección habitual de iOptron; consultar el manual."
          }
        }
      }
    },
    "Normal mode updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus-Aktualisierung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones en modo Normal"
          }
        }
      }
    },
    "Normal mode, but the mount still reported a placeholder position after 20 s, so it wasn't synced": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, aber die Montierung meldete nach 20 s noch eine Platzhalterposition, daher nicht synchronisiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal, pero la montura seguía indicando una posición provisional tras 20 s, así que no se sincronizó"
          }
        }
      }
    },
    "Normal mode, synced on %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, synchronisiert auf %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal, sincronizado con %@"
          }
        }
      }
    },
    "Normal mode, synced on %@, but %@. In the mount log.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus, synchronisiert auf %1$@, aber %2$@. Im Montierungsprotokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Normal mode, synced on %1$@, but %2$@. In the mount log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal, sincronizado con %1$@, pero %2$@. Ver el registro de la montura."
          }
        }
      }
    },
    "Normal mode: reads where the mount points once each update period while it slews, so the scope marker moves with it. Each read is logged; turn this off if gotos stutter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmodus: liest während eines Schwenks einmal pro Aktualisierungsintervall, wohin die Montierung zeigt, damit die Teleskopmarkierung mitläuft. Jeder Lesevorgang wird protokolliert; ausschalten, falls GoTos stocken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Normal: lee hacia dónde apunta la montura en cada periodo de actualización mientras se mueve, para que el marcador del telescopio la acompañe. Cada lectura se registra; desactivarlo si los goto van a trompicones."
          }
        }
      }
    },
    "Not calibrated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kalibriert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin calibrar"
          }
        }
      }
    },
    "Not downloaded yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no descargado"
          }
        }
      }
    },
    "Not found": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gefunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontrado"
          }
        }
      }
    },
    "Not sure? Take the mount's reading, then centre a bright star or planet and use Sync on target.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicher? Den Wert der Montierung übernehmen, dann einen hellen Stern oder Planeten zentrieren und „Auf Ziel synchronisieren“ verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No está seguro? Tomar la lectura de la montura y después centrar una estrella o planeta brillante y usar Sincronizar con el objetivo."
          }
        }
      }
    },
    "Nothing called that in the loaded catalogue. Turn on a source that has it under Objects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts mit diesem Namen im geladenen Katalog. Unter „Objekte“ eine Quelle aktivieren, die es enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada con ese nombre en el catálogo cargado. Activar en Objetos una fuente que lo contenga."
          }
        }
      }
    },
    "Nothing found for %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden für %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada para %@."
          }
        }
      }
    },
    "Nothing hidden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgeblendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto"
          }
        }
      }
    },
    "Nothing in the next %lld days with these settings. Try a lower peak or more days.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit diesen Einstellungen nichts innerhalb von %lld Tag. Niedrigere Kulmination oder mehr Tage versuchen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit diesen Einstellungen nichts innerhalb von %lld Tagen. Niedrigere Kulmination oder mehr Tage versuchen."
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en los próximos %lld días con estos ajustes. Probar con una culminación más baja o más días."
          }
        }
      }
    },
    "Nothing selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgewählt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada seleccionado"
          }
        }
      }
    },
    "Nothing stands out from the sky there. Click right on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort hebt sich nichts vom Himmel ab. Direkt darauf klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada destaca del cielo ahí. Hacer clic justo encima."
          }
        }
      }
    },
    "Now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora"
          }
        }
      }
    },
    "Number": {
      "comment": "Satellite list column: NORAD number",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número"
          }
        }
      }
    },
    "Numbered as on the hand controller. Search by number, such as M13 or C14. Positions and data from OpenNGC.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeriert wie auf der Handsteuerbox. Nach Nummer suchen, etwa M13 oder C14. Positionen und Daten von OpenNGC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerados como en el mando de control. Buscar por número, como M13 o C14. Posiciones y datos de OpenNGC."
          }
        }
      }
    },
    "OK": {
      "localizations": {
