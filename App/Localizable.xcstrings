    "No location yet: set one in Settings, or search for a place.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokalitet endnu: angiv en i Indstillinger, eller søg efter et sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Standort: in den Einstellungen festlegen oder nach einem Ort suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ubicación: establecer una en Ajustes o buscar un lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä sijaintia: aseta se Asetuksissa tai hae paikkaa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen posisjon ennå: angi en i Innstillinger, eller søk etter et sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen locatie: stel er een in bij Instellingen of zoek een plaats."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plats än: ställ in en i Inställningar eller sök efter en ort."
          }
        }
      }
    },
