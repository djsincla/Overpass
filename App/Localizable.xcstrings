    "Every star with an IAU name to magnitude 4, brightest first. Passive tracking sends the mount there and lets it track at the sidereal rate.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle stjerner med et IAU-navn til magnitude 4, lysstærkeste først. Passiv sporing sender monteringen derhen og lader den spore med siderisk hastighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stern mit IAU-Namen bis Größenklasse 4, hellste zuerst. Die passive Nachführung fährt die Montierung dorthin und lässt sie siderisch nachführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las estrellas con nombre de la IAU hasta magnitud 4, las más brillantes primero. El seguimiento Pasivo envía la montura allí y la deja seguir a velocidad sideral."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen IAU-nimetty tähti magnitudiin 4 asti, kirkkaimmat ensin. Passiivinen seuranta ohjaa jalustan kohteeseen ja antaa sen seurata sideerisellä nopeudella."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver stjerne med IAU-navn ned til størrelsesklasse 4, lyseste først. Passiv følging sender monteringen dit og lar den følge med siderisk hastighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ster met een IAU-naam tot magnitude 4, helderste eerst. Passief volgen stuurt de montering erheen en laat hem op siderische snelheid volgen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje stjärna med IAU-namn till magnitud 4, ljusast först. Passiv följning skickar dit monteringen och låter den följa i siderisk hastighet."
          }
        }
      }
    },
