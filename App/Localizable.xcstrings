            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ingenting de neste %lld dagen med disse innstillingene. Prøv lavere høyeste punkt eller flere dager."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ingenting de neste %lld dagene med disse innstillingene. Prøv lavere høyeste punkt eller flere dager."
