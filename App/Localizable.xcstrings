    "Corrected for Doppler now, though it's below the horizon. From the SatNOGS DB.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigeret for Doppler nu, selvom den er under horisonten. Fra SatNOGS DB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt Doppler-korrigiert, obwohl unter dem Horizont. Aus der SatNOGS DB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregido por Doppler ahora, aunque está bajo el horizonte. De la SatNOGS DB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppler-korjattu nyt, vaikka se on horisontin alapuolella. Lähde: SatNOGS DB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopplerkorrigert nå, selv om den er under horisonten. Fra SatNOGS DB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu gecorrigeerd voor doppler, hoewel hij onder de horizon staat. Uit de SatNOGS DB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopplerkorrigerad nu, fast den är under horisonten. Från SatNOGS DB."
          }
        }
      }
    },
    "Corrected for Doppler now, with the shift and how fast it's changing. From the SatNOGS DB.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigeret for Doppler nu, med forskydningen og hvor hurtigt den ændrer sig. Fra SatNOGS DB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt Doppler-korrigiert, mit Verschiebung und deren Änderungsrate. Aus der SatNOGS DB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregido por Doppler ahora, con el desplazamiento y su ritmo de cambio. De la SatNOGS DB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppler-korjattu nyt, siirtymä ja sen muutosnopeus mukana. Lähde: SatNOGS DB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopplerkorrigert nå, med forskyvningen og hvor fort den endrer seg. Fra SatNOGS DB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu gecorrigeerd voor doppler, met de verschuiving en hoe snel die verandert. Uit de SatNOGS DB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopplerkorrigerad nu, med förskjutningen och hur snabbt den ändras. Från SatNOGS DB."
          }
        }
      }
    },
