    "Calibrate first, so Overpass knows how the image moves with the mount.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrer først, så Overpass ved, hvordan billedet bevæger sig med monteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst kalibrieren, damit Overpass weiß, wie sich das Bild mit der Montierung bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrar primero, para que Overpass sepa cómo se mueve la imagen con la montura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibroi ensin, jotta Overpass tietää, miten kuva liikkuu jalustan mukana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrer først, så Overpass vet hvordan bildet beveger seg med monteringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreer eerst, zodat Overpass weet hoe het beeld met de montering beweegt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrera först, så att Overpass vet hur bilden rör sig med monteringen."
          }
        }
      }
    },
    "Calibrate over USB, with tracking stopped and a bright star centred.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrer via USB med sporingen stoppet og en klar stjerne i midten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über USB kalibrieren, mit gestoppter Nachführung und einem hellen Stern in der Bildmitte."
          }
        },
        "en": {
